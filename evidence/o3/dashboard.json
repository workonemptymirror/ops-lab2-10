      "panel-4": {
        "kind": "Panel",
        "spec": {
          "id": 4,
          "title": "服务 RED 1｜按接口 QPS / 5xx比例",
          "description": "读写接口分别展示。QPS与比例使用独立单位轴；仅表示服务端看到的请求。",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "dg2pnpiv7lbeod"
                      },
                      "spec": {
                        "expr": "sum by (route) (rate(http_requests_total{job=\"enrolld\",route=~\"/api/courses/.*|/api/enroll\"}[1m]))",
                        "legendFormat": "{{route}} QPS",
                        "range": true
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                },
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "dg2pnpiv7lbeod"
                      },
                      "spec": {
                        "expr": "(sum by (route) (rate(http_requests_total{job=\"enrolld\",route=~\"/api/courses/.*|/api/enroll\",code=~\"5..\"}[1m])) or (0 * sum by (route) (rate(http_requests_total{job=\"enrolld\",route=~\"/api/courses/.*|/api/enroll\"}[1m])))) / sum by (route) (rate(http_requests_total{job=\"enrolld\",route=~\"/api/courses/.*|/api/enroll\"}[1m]))",
                        "legendFormat": "{{route}} 5xx比例",
                        "range": true
                      }
                    },
                    "refId": "B",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "timeseries",
            "version": "",
            "spec": {
              "options": {
                "legend": {
                  "displayMode": "list",
                  "placement": "bottom",
                  "showLegend": true
                },
                "tooltip": {
                  "mode": "multi"
                }
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "reqps",
                  "custom": {
                    "drawStyle": "line",
                    "fillOpacity": 0,
                    "lineWidth": 1
                  }
                },
                "overrides": [
                  {
                    "matcher": {
                      "id": "byRegexp",
                      "options": "^.*\\ QPS$"
                    },
                    "properties": [
                      {
                        "id": "unit",
                        "value": "reqps"
                      }
                    ]
                  },
                  {
                    "matcher": {
                      "id": "byRegexp",
                      "options": "^.*\\ 5xx比例$"
